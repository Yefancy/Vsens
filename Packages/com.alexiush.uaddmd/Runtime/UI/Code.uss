.Code {
	margin-top: 25px;
	padding: 25px;
	background-color: #f5f5f5;
}

.InlineCode {
	padding-top: 2px;
	padding-right: 6px;
	padding-bottom: 2px;
	padding-left: 6px;
	margin-right: 2px;
	border-top-left-radius: 6px;
	border-top-right-radius: 6px;
	border-bottom-right-radius: 6px;
	border-bottom-left-radius: 6px;
	background-color: rgba(32, 37, 44, 0.12);
}
